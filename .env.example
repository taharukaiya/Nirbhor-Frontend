# Nirbhor Frontend Environment Configuration Example
# 
# Architectural Intent:
# Defines the environment variables required to run the frontend application.
# The application uses relative proxy routing by default, but allows explicit 
# URLs for staging/production deployments against independent backend servers.
#
# Copy this file to .env and adjust variables as needed for local or production deployments.

# Base API URL (e.g. /api for unified relative proxy, or https://api.nirbhor.com/api for custom remote API)
VITE_API_URL=/api

# WebSocket URL (leave empty for same-origin unified application server, or specify custom socket host)
VITE_SOCKET_URL=
