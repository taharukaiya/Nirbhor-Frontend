# Frontend Environment Variables

# API Configuration
VITE_API_URL=http://localhost:5000/api

# Google OAuth
# Get your Google Client ID from: https://console.cloud.google.com/
# 1. Create a new project
# 2. Enable Google+ API
# 3. Create OAuth 2.0 credentials (Web application)
# 4. Add authorized JavaScript origins: http://localhost:5173, https://yourdomain.com
# 5. Add authorized redirect URIs: http://localhost:5000, http://localhost:5173
VITE_GOOGLE_CLIENT_ID=your-google-client-id-here.apps.googleusercontent.com
